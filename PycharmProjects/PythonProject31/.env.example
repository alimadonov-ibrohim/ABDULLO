# === Asosiy sozlamalar (MAJBURIY) ===
# @BotFather dan olingan token
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Admin(lar)ning Telegram ID si — vergul bilan ajratilgan
ADMIN_IDS=123456789

# Avto-signallar kanali: @username yoki -100... ID (bo'sh bo'lsa VIP'larga xususiy yuboriladi)
CHANNEL_ID=

# === Ixtiyoriy sozlamalar ===
DB_NAME=trading_bot.db
LOG_LEVEL=INFO

SCAN_INTERVAL_MINUTES=60
AUTO_SIGNAL_MIN_CONFIDENCE=75
SIGNAL_COOLDOWN_HOURS=8

MAX_RISK_PERCENT=1.5

# Forex/gold OHLC ma'lumotlari uchun https://twelvedata.com bepul API key
TWELVEDATA_API_KEY=

BINANCE_API_BASE=https://api.binance.com
